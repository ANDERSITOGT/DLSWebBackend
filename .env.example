# Variables para configurar en Railway (Variables)
# PostgreSQL (en Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://usuario:password@host:5432/basedatos?schema=public

# Secreto para firmar JWT (obligatorio, usar un valor largo y aleatorio)
JWT_SECRET=cambia_esto_por_un_secreto_largo

# Railway lo inyecta automáticamente; solo para desarrollo local
PORT=3001

# Origen(es) permitidos por CORS, separados por coma. Vacío = permite todos
CORS_ORIGIN=https://tu-frontend.example.com
